{
  "name": "pre-commit-reviewer-analyzer",
  "displayName": "Pre-Commit Reviewer & Analyzer",
  "description": "AI-powered agent engine for reviewing staged changes, calculating PR weight scores, and analyzing developer metrics before committing.",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Source Control",
    "Machine Learning",
    "Linters"
  ],
  "keywords": [
    "git",
    "pre-commit",
    "code review",
    "pr weight",
    "copilot agent",
    "developer activity"
  ],
  "activationEvents": [
    "*",
    "onCommand:preCommitAnalyzer.runManualReview"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "preCommitAnalyzer.runManualReview",
        "title": "Pre-Commit: Analyze Staged Changes Now"
      }
    ],
    "configuration": {
      "title": "Pre-Commit Reviewer & Analyzer",
      "properties": {
        "preCommitAnalyzer.enablePrWeight": {
          "type": "boolean",
          "default": true,
          "description": "Calculate PR Weight Score and track developer activity impact."
        },
        "preCommitAnalyzer.showModalDialog": {
          "type": "boolean",
          "default": true,
          "description": "Show a modal dialog when committing via VS Code GUI button."
        }
      }
    }
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.23.0",
    "typescript": "^5.3.0"
  }
}
